# Server Settings
PORT=8080
ENVIRONMENT=development

# Database Settings
# Format: postgres://username:password@host:port/database_name?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/webifylab?sslmode=disable

# Telegram Notifications (Opsional)
# Dapatkan token dari @BotFather dan chat_id dari @userinfobot (atau ID grup)
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Resend Email Notifications (Opsional)
RESEND_API_KEY=re_your_resend_api_key_here
ADMIN_EMAIL=admin@yourdomain.com
