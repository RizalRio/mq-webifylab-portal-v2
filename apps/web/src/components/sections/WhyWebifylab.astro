---
import { WHY_ITEMS } from "../../lib/constants";

const icons: Record<string, string> = {
  "layout-template": `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>`,
  "share-2": `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>`,
  brain: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96-.46 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3A2.5 2.5 0 0 1 9.5 2Z"/><path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96-.46 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3A2.5 2.5 0 0 0 14.5 2Z"/></svg>`,
  "message-square": `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
};
---

<section id="mengapa" class="section-pad why-section" aria-labelledby="why-title">
  <div class="container-site">

    <!-- Header -->
    <div class="why-header">
      <span class="section-label">Keunggulan Kami</span>
      <h2 class="section-title" id="why-title">Mengapa Webifylab?</h2>
      <p class="section-subtitle why-subtitle">
        Kami bukan sekadar vendor — kami adalah partner teknologi yang
        memahami visi jangka panjang bisnis Anda.
      </p>
    </div>

    <!-- 2×2 Grid -->
    <div class="why-grid" role="list">
      {WHY_ITEMS.map((item, i) => (
        <article class="why-card" role="listitem" style={`--delay: ${i * 0.1}s`}>
          <div class="icon-wrap icon-wrap-lg why-icon" aria-hidden="true">
            <Fragment set:html={icons[item.icon]} />
          </div>
          <div>
            <h3 class="why-card-title">{item.title}</h3>
            <p class="why-card-desc">{item.description}</p>
          </div>
        </article>
      ))}
    </div>

    <!-- Bottom CTA strip -->
    <div class="why-bottom-cta">
      <p class="why-bottom-text">Siap memulai perjalanan ekosistem digital Anda?</p>
      <a href="#kontak" class="btn-primary">
        Mulai Konsultasi Gratis
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>
</section>

<style>
  .why-section {
    background-color: var(--color-neutral-100);
  }
  .why-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 3rem;
  }
  .why-subtitle {
    text-align: center;
    margin-inline: auto;
  }
  .why-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .why-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .why-card {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    background: #fff;
    border-radius: var(--radius-card);
    padding: 1.75rem;
    box-shadow: var(--shadow-card);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
    animation: fadeInUp 0.6s ease-out both;
    animation-delay: var(--delay, 0s);
  }
  .why-card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }
  .why-icon {
    flex-shrink: 0;
    margin-top: 0.125rem;
  }
  .why-card-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-neutral-900);
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }
  .why-card-desc {
    font-size: 0.9375rem;
    color: var(--color-neutral-700);
    line-height: 1.7;
  }

  /* Bottom CTA */
  .why-bottom-cta {
    margin-top: 3.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }
  .why-bottom-text {
    font-size: 1.0625rem;
    color: var(--color-neutral-700);
  }
</style>
