---
import { WHY_ITEMS } from "../../lib/constants";
import { LayoutTemplate, Share2, Brain, MessageSquare, ArrowRight } from '@lucide/astro';

const icons: Record<string, any> = {
  "layout-template": LayoutTemplate,
  "share-2": Share2,
  brain: Brain,
  "message-square": MessageSquare,
};
---

<section id="mengapa" class="section-pad why-section" aria-labelledby="why-title">
  <div class="container-site">

    <!-- Header -->
    <div class="why-header">
      <span class="section-label">Keunggulan Kami</span>
      <h2 class="section-title" id="why-title">Mengapa Webifylab?</h2>
      <p class="section-subtitle why-subtitle">
        Kami bukan sekadar vendor — kami adalah partner teknologi yang
        memahami visi jangka panjang bisnis Anda.
      </p>
    </div>

    <!-- 2×2 Grid -->
    <div class="why-grid" role="list">
      {WHY_ITEMS.map((item, i) => (
        <article class="why-card" role="listitem" style={`--delay: ${i * 0.1}s`}>
          <div class="icon-wrap icon-wrap-lg why-icon" aria-hidden="true">
            {(() => {
              const IconComp = icons[item.icon];
              return <IconComp width="24" height="24" />;
            })()}
          </div>
          <div>
            <h3 class="why-card-title">{item.title}</h3>
            <p class="why-card-desc">{item.description}</p>
          </div>
        </article>
      ))}
    </div>

    <!-- Bottom CTA strip -->
    <div class="why-bottom-cta">
      <p class="why-bottom-text">Siap memulai perjalanan ekosistem digital Anda?</p>
      <a href="#kontak" class="btn-primary">
        Mulai Konsultasi Gratis
        <ArrowRight width="16" height="16" aria-hidden="true" stroke-width={2.5} />
      </a>
    </div>

  </div>
</section>

<style>
  .why-section {
    background-color: var(--color-neutral-100);
  }
  .why-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 3rem;
  }
  .why-subtitle {
    text-align: center;
    margin-inline: auto;
  }
  .why-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }
  @media (min-width: 768px) {
    .why-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .why-card {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    background: #fff;
    border-radius: var(--radius-card);
    padding: 1.75rem;
    box-shadow: var(--shadow-card);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
    animation: fadeInUp 0.6s ease-out both;
    animation-delay: var(--delay, 0s);
  }
  .why-card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }
  .why-icon {
    flex-shrink: 0;
    margin-top: 0.125rem;
  }
  .why-card-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-neutral-900);
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }
  .why-card-desc {
    font-size: 0.9375rem;
    color: var(--color-neutral-700);
    line-height: 1.7;
  }

  /* Bottom CTA */
  .why-bottom-cta {
    margin-top: 3.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }
  .why-bottom-text {
    font-size: 1.0625rem;
    color: var(--color-neutral-700);
  }
</style>
