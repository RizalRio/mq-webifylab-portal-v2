---
const problems = [
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>`,
    title: "Website Saja Tidak Cukup",
    description:
      "Bisnis Anda butuh sistem yang terintegrasi — bukan sekadar halaman statis yang tidak menghasilkan apa-apa.",
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
    title: "Vendor yang Hilang Setelah Proyek Selesai",
    description:
      "Anda butuh partner jangka panjang yang memahami bisnis Anda, bukan vendor yang hanya datang saat ada proyek.",
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96-.46 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 1.98-3A2.5 2.5 0 0 1 9.5 2Z"/><path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96-.46 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-1.98-3A2.5 2.5 0 0 0 14.5 2Z"/></svg>`,
    title: "Tidak Siap Menghadapi Era AI & Data",
    description:
      "Kompetitor Anda sudah mulai otomatisasi dan menggunakan data. Apakah Anda siap tertinggal?",
  },
];
---

<section id="masalah" class="section-pad problem-section" aria-labelledby="problem-title">
  <div class="container-site">

    <!-- Section header -->
    <div class="problem-header">
      <span class="section-label">Pain Points</span>
      <h2 class="section-title" id="problem-title">
        Mengapa Bisnis Anda Butuh<br />
        Partner Teknologi yang Tepat?
      </h2>
      <p class="section-subtitle problem-subtitle">
        Banyak bisnis kehilangan kesempatan karena partner teknologi yang
        tidak memahami kebutuhan jangka panjang.
      </p>
    </div>

    <!-- Cards grid -->
    <div class="problem-grid" role="list">
      {problems.map((problem, i) => (
        <article class="card problem-card" role="listitem" style={`--delay: ${i * 0.1}s`}>
          <div class="icon-wrap icon-wrap-lg" aria-hidden="true">
            <Fragment set:html={problem.icon} />
          </div>
          <h3 class="problem-card-title">{problem.title}</h3>
          <p class="problem-card-desc">{problem.description}</p>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .problem-section {
    background-color: var(--color-neutral-100);
  }
  .problem-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 3rem;
  }
  .problem-subtitle {
    text-align: center;
    margin-inline: auto;
  }
  .problem-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .problem-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .problem-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .problem-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    animation: fadeInUp 0.6s ease-out both;
    animation-delay: var(--delay, 0s);
  }
  .problem-card-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-neutral-900);
    line-height: 1.4;
  }
  .problem-card-desc {
    font-size: 0.9375rem;
    color: var(--color-neutral-700);
    line-height: 1.7;
    flex: 1;
  }
</style>
