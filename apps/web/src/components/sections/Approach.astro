---
import { APPROACH_STEPS } from "../../lib/constants";
import { Headphones, LayoutTemplate, Code, Rocket } from "@lucide/astro";

const stepIcons = [
  Headphones,
  LayoutTemplate,
  Code,
  Rocket,
];
---

<section id="pendekatan" class="section-pad approach-section" aria-labelledby="approach-title">
  <div class="container-site">

    <!-- Header -->
    <div class="approach-header">
      <span class="section-label">Metodologi</span>
      <h2 class="section-title" id="approach-title">Pendekatan Kami</h2>
      <p class="section-subtitle approach-subtitle">
        Metodologi kerja yang terstruktur untuk memastikan proyek berjalan
        lancar dan hasil maksimal.
      </p>
    </div>

    <!-- Steps: horizontal desktop, vertical mobile -->
    <div class="approach-steps" role="list">
      {APPROACH_STEPS.map((step, i) => (
        <div class="approach-step-wrapper" role="listitem">
          <article class="approach-step" style={`--delay: ${i * 0.12}s`}>

            <!-- Step number circle -->
            <div class="approach-step-num" aria-label={`Langkah ${step.number}`}>
              <span aria-hidden="true">
                {(() => {
                  const IconComp = stepIcons[i];
                  return <IconComp width="22" height="22" />;
                })()}
              </span>
            </div>

            <!-- Content -->
            <div class="approach-step-content">
              <span class="approach-step-badge">{step.number}</span>
              <h3 class="approach-step-title">{step.title}</h3>
              <p class="approach-step-desc">{step.description}</p>
            </div>

          </article>

          <!-- Connector arrow (not after last item) -->
          {i < APPROACH_STEPS.length - 1 && (
            <div class="approach-connector" aria-hidden="true">
              <!-- Desktop: horizontal arrow -->
              <svg class="connector-desktop" width="40" height="20" viewBox="0 0 40 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M0 10 H32 M28 4 L38 10 L28 16" stroke="var(--color-neutral-300)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <!-- Mobile: vertical arrow -->
              <svg class="connector-mobile" width="20" height="32" viewBox="0 0 20 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 0 V24 M4 20 L10 30 L16 20" stroke="var(--color-neutral-300)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- Tech stack logos strip -->
    <div class="tech-stack-strip" aria-label="Tech stack yang kami gunakan">
      <p class="tech-stack-label">Tech Stack Kami</p>
      <div class="tech-stack-items">
        {["React", "Next.js", "Astro", "Go", "PostgreSQL", "Docker", "Python", "TensorFlow"].map((tech) => (
          <span class="tech-chip">{tech}</span>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .approach-section {
    background-color: #ffffff;
  }
  .approach-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 3.5rem;
  }
  .approach-subtitle {
    text-align: center;
    margin-inline: auto;
  }

  /* ── Steps layout ─────────────────────────────────────────────── */
  .approach-steps {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }
  @media (min-width: 768px) {
    .approach-steps {
      flex-direction: row;
      align-items: flex-start;
      justify-content: center;
      gap: 0;
    }
  }

  .approach-step-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
  }
  @media (min-width: 768px) {
    .approach-step-wrapper {
      flex-direction: row;
      align-items: flex-start;
    }
  }

  .approach-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.5rem 1rem;
    max-width: 240px;
    animation: fadeInUp 0.6s ease-out both;
    animation-delay: var(--delay, 0s);
    flex: 1;
  }

  /* Number circle */
  .approach-step-num {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--color-accent-indigo), var(--color-primary));
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    box-shadow: 0 4px 16px rgb(79 70 229 / 0.35);
    margin-bottom: 1.25rem;
    flex-shrink: 0;
  }

  .approach-step-badge {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--color-accent-indigo);
    margin-bottom: 0.375rem;
    background: rgb(79 70 229 / 0.08);
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
  }

  .approach-step-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-neutral-900);
    margin-bottom: 0.625rem;
    line-height: 1.3;
  }
  .approach-step-desc {
    font-size: 0.875rem;
    color: var(--color-neutral-700);
    line-height: 1.65;
  }

  /* Connectors */
  .approach-connector {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0;
    flex-shrink: 0;
  }
  .connector-desktop { display: none; }
  .connector-mobile  { display: block; }
  @media (min-width: 768px) {
    .connector-desktop { display: block; }
    .connector-mobile  { display: none; }
    .approach-connector {
      padding: 0 0.25rem;
      margin-top: 1.5rem;
    }
  }

  /* ── Tech stack strip ─────────────────────────────────────────── */
  .tech-stack-strip {
    margin-top: 4rem;
    text-align: center;
    border-top: 1px solid var(--color-neutral-300);
    padding-top: 2.5rem;
  }
  .tech-stack-label {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-neutral-500);
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .tech-stack-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    justify-content: center;
  }
  .tech-chip {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-neutral-700);
    background: var(--color-neutral-100);
    border: 1px solid var(--color-neutral-300);
    border-radius: 9999px;
    padding: 0.3rem 0.875rem;
    transition: all 0.2s;
  }
  .tech-chip:hover {
    background: rgb(79 70 229 / 0.08);
    border-color: var(--color-accent-indigo);
    color: var(--color-accent-indigo);
  }
</style>
