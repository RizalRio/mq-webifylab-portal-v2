---
import { PORTFOLIO_ITEMS } from "../../lib/constants";
import { Clock, ArrowRight } from "@lucide/astro";

const gradients = [
  "linear-gradient(135deg, #4F46E5 0%, #06B6D4 100%)",
  "linear-gradient(135deg, #1E3A5F 0%, #4F46E5 100%)",
  "linear-gradient(135deg, #06B6D4 0%, #4F46E5 100%)",
];
---

<section id="portfolio" class="section-pad portfolio-section" aria-labelledby="portfolio-title">
  <div class="container-site">

    <!-- Header -->
    <div class="portfolio-header">
      <span class="section-label">Karya Kami</span>
      <h2 class="section-title" id="portfolio-title">Portfolio</h2>
      <p class="section-subtitle portfolio-subtitle">
        Beberapa proyek yang telah kami kerjakan. Lebih banyak segera hadir.
      </p>
    </div>

    <!-- Cards -->
    <div class="portfolio-grid" role="list">
      {PORTFOLIO_ITEMS.map((item, i) => (
        <article
          class="portfolio-card"
          role="listitem"
          style={`--delay: ${i * 0.1}s`}
          aria-label={item.title}
        >
          <!-- Thumbnail -->
          <div class="portfolio-thumb" style={`background: ${gradients[i]}`} aria-hidden="true">
            <!-- Grid pattern overlay -->
            <div class="portfolio-thumb-grid"></div>

            {item.comingSoon && (
              <div class="portfolio-coming-soon">
                <Clock width="16" height="16" aria-hidden="true" stroke-width={2} />
                <span>Coming Soon</span>
              </div>
            )}

            <!-- Category decoration nodes -->
            <div class="portfolio-thumb-decoration">
              <div class="thumb-node thumb-node-1"></div>
              <div class="thumb-node thumb-node-2"></div>
              <div class="thumb-node thumb-node-3"></div>
            </div>
          </div>

          <!-- Content -->
          <div class="portfolio-content">
            <span class="badge badge-cyan portfolio-category">{item.category}</span>
            <h3 class="portfolio-title">{item.title}</h3>
            <p class="portfolio-desc">{item.description}</p>
          </div>
        </article>
      ))}
    </div>

    <!-- CTA under portfolio -->
    <div class="portfolio-cta-strip">
      <p class="portfolio-cta-text">Punya proyek yang ingin kami kerjakan bersama?</p>
      <a href="#kontak" class="btn-primary">
        Diskusikan Proyek Anda
        <ArrowRight width="16" height="16" stroke-width={2.5} aria-hidden="true" />
      </a>
    </div>

  </div>
</section>

<style>
  .portfolio-section {
    background-color: var(--color-neutral-100);
  }
  .portfolio-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 3rem;
  }
  .portfolio-subtitle {
    text-align: center;
    margin-inline: auto;
  }
  .portfolio-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .portfolio-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .portfolio-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .portfolio-card {
    background: #fff;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: box-shadow 0.3s ease, transform 0.3s ease;
    animation: fadeInUp 0.6s ease-out both;
    animation-delay: var(--delay, 0s);
  }
  .portfolio-card:hover {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-3px);
  }

  /* Thumbnail */
  .portfolio-thumb {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .portfolio-thumb-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.07) 1px, transparent 1px);
    background-size: 20px 20px;
  }

  /* Coming soon badge */
  .portfolio-coming-soon {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    background: rgba(255,255,255,0.92);
    color: var(--color-neutral-900);
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    backdrop-filter: blur(4px);
  }

  /* Decoration nodes */
  .portfolio-thumb-decoration {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .thumb-node {
    position: absolute;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
  }
  .thumb-node-1 { width: 80px; height: 80px; top: -20px; right: -20px; }
  .thumb-node-2 { width: 40px; height: 40px; bottom: 16px; left: 16px; }
  .thumb-node-3 { width: 24px; height: 24px; top: 50%; right: 24px; transform: translateY(-50%); }

  /* Card content */
  .portfolio-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }
  .portfolio-category {
    align-self: flex-start;
  }
  .portfolio-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-neutral-900);
    line-height: 1.4;
  }
  .portfolio-desc {
    font-size: 0.875rem;
    color: var(--color-neutral-500);
    line-height: 1.6;
  }

  /* Bottom CTA */
  .portfolio-cta-strip {
    margin-top: 3.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }
  .portfolio-cta-text {
    font-size: 1.0625rem;
    color: var(--color-neutral-700);
  }
</style>
