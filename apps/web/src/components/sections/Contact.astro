---
import { SITE } from "../../lib/constants";
import { Mail, MessageCircle, Check, AlertCircle, ArrowRight, Loader } from "@lucide/astro";

// Replace with your actual Formspree endpoint
const FORMSPREE_ENDPOINT = "https://formspree.io/f/YOUR_FORM_ID";

const SERVICE_OPTIONS = [
  "Pengembangan Aplikasi (Web/Mobile)",
  "Desain Grafis & Web Design",
  "SaaS & Ekosistem Digital",
  "Konsultasi AI & Data",
  "Lainnya",
];

const WA_MESSAGE = encodeURIComponent(
  "Halo Webifylab, saya tertarik untuk konsultasi mengenai kebutuhan teknologi bisnis saya."
);
---

<section id="kontak" class="contact-section" aria-labelledby="contact-title">
  <!-- Decorative background -->
  <div class="contact-bg" aria-hidden="true"></div>

  <div class="container-site contact-container">

    <!-- Left: Headline -->
    <div class="contact-left">
      <span class="contact-label">Kontak Kami</span>
      <h2 class="contact-title" id="contact-title">
        Siap Membangun Sesuatu yang<br />
        <span class="contact-title-accent">Luar Biasa?</span>
      </h2>
      <p class="contact-subtitle">
        Ceritakan ide atau tantangan Anda. Konsultasi pertama
        <strong>gratis</strong>, tanpa komitmen.
      </p>

      <!-- Quick contact info -->
      <div class="contact-info">
        <a href={`mailto:${SITE.email}`} class="contact-info-item">
          <div class="contact-info-icon">
            <Mail width="18" height="18" stroke-width={2} aria-hidden="true" />
          </div>
          <span>{SITE.email}</span>
        </a>
        <a href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener noreferrer" class="contact-info-item">
          <div class="contact-info-icon">
            <MessageCircle width="18" height="18" stroke-width={2} aria-hidden="true" />
          </div>
          <span>WhatsApp Langsung</span>
        </a>
      </div>
    </div>

    <!-- Right: Form card -->
    <div class="contact-form-wrapper">
      <!-- Success state (hidden by default) -->
      <div id="contact-success" class="contact-success" aria-live="polite" hidden>
        <div class="contact-success-icon">
          <Check width="32" height="32" stroke-width={2.5} class="text-success" aria-hidden="true" />
        </div>
        <h3>Pesan Terkirim! ✅</h3>
        <p>Terima kasih telah menghubungi kami. Kami akan membalas dalam 1×24 jam kerja.</p>
        <button id="contact-reset-btn" class="btn-secondary" style="margin-top:1rem">
          Kembali ke Form
        </button>
      </div>

      <!-- Error state (hidden by default) -->
      <div id="contact-error" class="contact-error" aria-live="polite" hidden>
        <div class="contact-error-icon">
          <AlertCircle width="28" height="28" stroke-width={2.5} class="text-error" aria-hidden="true" />
        </div>
        <h3>Oops! Terjadi Kesalahan ❌</h3>
        <p>Gagal mengirim pesan. Silakan coba lagi atau hubungi kami via WhatsApp.</p>
        <div class="contact-error-actions">
          <button id="contact-retry-btn" class="btn-secondary">Coba Lagi</button>
          <a href={`https://wa.me/${SITE.whatsapp}?text=${WA_MESSAGE}`} target="_blank" rel="noopener noreferrer" class="btn-whatsapp">
            Chat WhatsApp
          </a>
        </div>
      </div>

      <!-- Form -->
      <form
        id="contact-form"
        class="contact-form"
        action={FORMSPREE_ENDPOINT}
        method="POST"
        novalidate
      >
        <!-- Name -->
        <div class="form-group">
          <label class="form-label" for="contact-name">
            Nama Lengkap <span class="form-required" aria-hidden="true">*</span>
          </label>
          <input
            type="text"
            id="contact-name"
            name="name"
            class="form-input"
            placeholder="Masukkan nama Anda"
            required
            autocomplete="name"
            aria-required="true"
          />
          <span class="form-error-msg" id="name-error" role="alert"></span>
        </div>

        <!-- Email -->
        <div class="form-group">
          <label class="form-label" for="contact-email">
            Email Aktif <span class="form-required" aria-hidden="true">*</span>
          </label>
          <input
            type="email"
            id="contact-email"
            name="email"
            class="form-input"
            placeholder="nama@email.com"
            required
            autocomplete="email"
            aria-required="true"
          />
          <span class="form-error-msg" id="email-error" role="alert"></span>
        </div>

        <!-- Service -->
        <div class="form-group">
          <label class="form-label" for="contact-service">
            Jenis Layanan yang Dibutuhkan <span class="form-required" aria-hidden="true">*</span>
          </label>
          <select
            id="contact-service"
            name="service"
            class="form-input"
            required
            aria-required="true"
          >
            <option value="" disabled selected>Pilih layanan</option>
            {SERVICE_OPTIONS.map((opt) => (
              <option value={opt}>{opt}</option>
            ))}
          </select>
          <span class="form-error-msg" id="service-error" role="alert"></span>
        </div>

        <!-- Message -->
        <div class="form-group">
          <label class="form-label" for="contact-message">
            Ceritakan Kebutuhan Anda <span class="form-required" aria-hidden="true">*</span>
          </label>
          <textarea
            id="contact-message"
            name="message"
            class="form-input contact-textarea"
            placeholder="Deskripsikan proyek atau tantangan Anda..."
            rows="5"
            required
            minlength="10"
            aria-required="true"
          ></textarea>
          <span class="form-error-msg" id="message-error" role="alert"></span>
        </div>

        <!-- Submit button -->
        <button type="submit" class="btn-primary contact-submit-btn" id="contact-submit">
          <span id="submit-text">Kirim Pesan</span>
          <ArrowRight id="submit-arrow" width="16" height="16" stroke-width={2.5} aria-hidden="true" />
          <!-- Spinner (hidden by default) -->
          <Loader id="submit-spinner" width="18" height="18" stroke-width={2.5} class="contact-spinner" style="display:none" aria-label="Mengirim..." />
        </button>

        <!-- WhatsApp alternative -->
        <div class="contact-wa-alt">
          <span>atau</span>
          <a
            href={`https://wa.me/${SITE.whatsapp}?text=${WA_MESSAGE}`}
            target="_blank"
            rel="noopener noreferrer"
            class="contact-wa-link"
            id="contact-wa-btn"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
            </svg>
            Chat via WhatsApp 💬
          </a>
        </div>

      </form>
    </div>

  </div>
</section>

<style>
  /* ── Section ────────────────────────────────────────────────── */
  .contact-section {
    position: relative;
    padding-block: var(--spacing-section-sm);
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .contact-section { padding-block: var(--spacing-section-md); }
  }
  @media (min-width: 1024px) {
    .contact-section { padding-block: var(--spacing-section-lg); }
  }

  .contact-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--color-primary) 0%, #2D3A8F 50%, var(--color-primary-dark) 100%);
    z-index: 0;
  }
  .contact-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size: 40px 40px;
  }

  /* ── Container ──────────────────────────────────────────────── */
  .contact-container {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .contact-container { grid-template-columns: 1fr 1fr; gap: 5rem; align-items: center; }
  }

  /* ── Left side ──────────────────────────────────────────────── */
  .contact-label {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent-cyan);
    margin-bottom: 1rem;
  }
  .contact-title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
  }
  .contact-title-accent {
    color: var(--color-accent-cyan);
  }
  .contact-subtitle {
    font-size: 1.0625rem;
    color: rgba(255,255,255,0.75);
    line-height: 1.7;
    margin-bottom: 2rem;
  }
  .contact-subtitle strong {
    color: #fff;
    font-weight: 600;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .contact-info-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: rgba(255,255,255,0.8);
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color 0.2s;
  }
  .contact-info-item:hover {
    color: #fff;
  }
  .contact-info-icon {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: rgba(255,255,255,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background 0.2s;
  }
  .contact-info-item:hover .contact-info-icon {
    background: rgba(255,255,255,0.15);
  }

  /* ── Form card ──────────────────────────────────────────────── */
  .contact-form-wrapper {
    background: #fff;
    border-radius: 1.5rem;
    padding: 2rem;
    box-shadow: 0 24px 64px -16px rgb(0 0 0 / 0.3);
  }
  @media (min-width: 640px) {
    .contact-form-wrapper { padding: 2.5rem; }
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .form-required {
    color: var(--color-error);
    margin-left: 2px;
  }
  .form-error-msg {
    font-size: 0.8125rem;
    color: var(--color-error);
    min-height: 1.25rem;
  }
  .contact-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .contact-submit-btn {
    width: 100%;
    justify-content: center;
    padding: 0.9rem 2rem;
    font-size: 1rem;
    margin-top: 0.25rem;
  }
  .contact-submit-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .contact-spinner {
    animation: spin 0.8s linear infinite;
  }

  /* WhatsApp alternative */
  .contact-wa-alt {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--color-neutral-500);
  }
  .contact-wa-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: #25D366;
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color 0.2s;
    min-height: 44px;
  }
  .contact-wa-link:hover {
    color: #1ea952;
  }

  /* ── Success / Error states ─────────────────────────────────── */
  .contact-success,
  .contact-error {
    text-align: center;
    padding: 2rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .contact-success h3,
  .contact-error h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-neutral-900);
  }
  .contact-success p,
  .contact-error p {
    font-size: 0.9375rem;
    color: var(--color-neutral-700);
    max-width: 360px;
    line-height: 1.6;
  }
  .contact-success-icon,
  .contact-error-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgb(16 185 129 / 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.5rem;
  }
  .contact-error-icon {
    background: rgb(239 68 68 / 0.1);
  }
  .contact-error-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 0.75rem;
  }
</style>

<script>
  const form        = document.getElementById("contact-form") as HTMLFormElement;
  const successEl   = document.getElementById("contact-success") as HTMLElement;
  const errorEl     = document.getElementById("contact-error") as HTMLElement;
  const submitBtn   = document.getElementById("contact-submit") as HTMLButtonElement;
  const submitText  = document.getElementById("submit-text") as HTMLSpanElement;
  const submitArrow = document.getElementById("submit-arrow") as HTMLElement;
  const spinner     = document.getElementById("submit-spinner") as HTMLElement;
  const resetBtn    = document.getElementById("contact-reset-btn") as HTMLButtonElement;
  const retryBtn    = document.getElementById("contact-retry-btn") as HTMLButtonElement;

  // ── Validation helpers ──────────────────────────────────────
  function showError(fieldId: string, message: string) {
    const input = document.getElementById(fieldId) as HTMLInputElement;
    const errEl = document.getElementById(`${fieldId.replace("contact-", "")}-error`) as HTMLElement;
    input.classList.add("error");
    errEl.textContent = message;
  }
  function clearError(fieldId: string) {
    const input = document.getElementById(fieldId) as HTMLInputElement;
    const errEl = document.getElementById(`${fieldId.replace("contact-", "")}-error`) as HTMLElement;
    input.classList.remove("error");
    errEl.textContent = "";
  }

  function validateForm(): boolean {
    let valid = true;
    const name    = (document.getElementById("contact-name") as HTMLInputElement).value.trim();
    const email   = (document.getElementById("contact-email") as HTMLInputElement).value.trim();
    const service = (document.getElementById("contact-service") as HTMLSelectElement).value;
    const message = (document.getElementById("contact-message") as HTMLTextAreaElement).value.trim();

    clearError("contact-name");
    clearError("contact-email");
    clearError("contact-service");
    clearError("contact-message");

    if (!name) { showError("contact-name", "Nama wajib diisi"); valid = false; }
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showError("contact-email", "Format email tidak valid"); valid = false;
    }
    if (!service) { showError("contact-service", "Pilih salah satu layanan"); valid = false; }
    if (!message || message.length < 10) {
      showError("contact-message", "Pesan terlalu singkat (min. 10 karakter)"); valid = false;
    }
    return valid;
  }

  // ── Submit handler ──────────────────────────────────────────
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!validateForm()) return;

    // Loading state
    submitBtn.disabled = true;
    submitText.textContent = "Mengirim pesan...";
    submitArrow.style.display = "none";
    spinner.style.display = "block";

    try {
      const data = new FormData(form);
      const res  = await fetch(form.action, {
        method: "POST",
        body: data,
        headers: { Accept: "application/json" },
      });

      if (res.ok) {
        form.hidden     = true;
        successEl.hidden = false;
        errorEl.hidden   = true;
      } else {
        throw new Error("Network response was not ok");
      }
    } catch {
      form.hidden     = false;
      errorEl.hidden   = false;
      successEl.hidden = true;
    } finally {
      submitBtn.disabled = false;
      submitText.textContent = "Kirim Pesan";
      submitArrow.style.display = "block";
      spinner.style.display = "none";
    }
  });

  // ── Reset / Retry ───────────────────────────────────────────
  [resetBtn, retryBtn].forEach((btn) => {
    btn?.addEventListener("click", () => {
      form.hidden      = false;
      successEl.hidden = true;
      errorEl.hidden   = true;
      form.reset();
    });
  });

  // ── Real-time field validation ──────────────────────────────
  ["contact-name", "contact-email", "contact-service", "contact-message"].forEach((id) => {
    const el = document.getElementById(id);
    el?.addEventListener("blur", () => {
      // Clear error on re-focus blur if now valid
      const val = (el as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement).value.trim();
      if (val) clearError(id);
    });
  });
</script>
