---
import { SERVICES } from "../../lib/constants";
import { Code, Palette, Network, Check, ArrowRight } from "@lucide/astro";

const icons: Record<string, any> = {
  code: Code,
  palette: Palette,
  network: Network,
};
---

<section id="layanan" class="section-pad services-section" aria-labelledby="services-title">
  <div class="container-site">

    <!-- Section header -->
    <div class="services-header">
      <span class="section-label">Layanan</span>
      <h2 class="section-title" id="services-title">Layanan Kami</h2>
      <p class="section-subtitle services-subtitle">
        Tiga pilar layanan yang saling terintegrasi untuk membangun
        ekosistem digital bisnis Anda.
      </p>
    </div>

    <!-- Cards grid -->
    <div class="services-grid" role="list">
      {SERVICES.map((service, i) => (
        <article class="card services-card" role="listitem" style={`--delay: ${i * 0.12}s`}>

          <!-- Badge (if any) -->
          {service.badge && (
            <div class="services-badge-wrap">
              <span class="badge badge-indigo">{service.badge}</span>
            </div>
          )}

          <!-- Icon -->
          <div class="icon-wrap icon-wrap-lg services-icon" aria-hidden="true">
            {(() => {
              const IconComp = icons[service.icon];
              return <IconComp width="24" height="24" />;
            })()}
          </div>

          <!-- Title -->
          <h3 class="services-card-title">{service.title}</h3>

          <!-- Description -->
          <p class="services-card-desc">{service.description}</p>

          <!-- Features list -->
          <ul class="services-features" aria-label={`Fitur ${service.title}`}>
            {service.features.map((feat) => (
              <li class="services-feature-item">
                <Check width="14" height="14" class="text-accent-indigo mt-[3px] shrink-0" stroke-width={2.5} aria-hidden="true" />
                <span>{feat}</span>
              </li>
            ))}
          </ul>

          <!-- Ghost CTA -->
          <a href="#kontak" class="btn-ghost services-cta">
            Pelajari Lebih Lanjut
            <ArrowRight width="14" height="14" stroke-width={2.5} aria-hidden="true" />
          </a>

        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-section {
    background-color: #ffffff;
  }
  .services-header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 3rem;
  }
  .services-subtitle {
    text-align: center;
    margin-inline: auto;
  }
  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 768px) {
    .services-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .services-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .services-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
    animation: fadeInUp 0.6s ease-out both;
    animation-delay: var(--delay, 0s);
  }
  .services-badge-wrap {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
  }
  .services-icon {
    margin-top: 0.25rem;
  }
  .services-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-neutral-900);
    line-height: 1.35;
    padding-right: 2rem; /* space for badge */
  }
  .services-card-desc {
    font-size: 0.9375rem;
    color: var(--color-neutral-700);
    line-height: 1.7;
  }
  .services-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
  }
  .services-feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-neutral-700);
    line-height: 1.5;
  }
  .services-cta {
    margin-top: 0.25rem;
    align-self: flex-start;
    padding-left: 0;
  }
</style>
