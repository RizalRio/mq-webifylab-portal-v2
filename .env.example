# ===========================================
# WebifyLab Portal - Environment Variables
# ===========================================
# Instruksi: Copy file ini menjadi .env dan isi nilainya
# cp .env.example .env

# -------------------------------------------
# 1. Application
# -------------------------------------------
# Gunakan 'development' di laptop, 'production' di VPS
APP_ENV=development
SITE_URL=http://localhost:3000
API_URL=http://localhost:8080

# -------------------------------------------
# 2. Database (PostgreSQL)
# -------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_USER=webifylab
DB_PASSWORD=your_secure_password_here_min_16_chars
DB_NAME=webifylab
DB_SSLMODE=disable

# -------------------------------------------
# 3. JWT Authentication
# -------------------------------------------
# Generate secret baru dengan command: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRY=24h
REFRESH_TOKEN_EXPIRY=168h

# -------------------------------------------
# 4. Resend Email Service
# -------------------------------------------
# Dapatkan dari: https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
ADMIN_EMAIL=admin@webifylab.my.id

# -------------------------------------------
# 5. Upload Limits (Opsional)
# -------------------------------------------
# 5MB dalam bytes (5 * 1024 * 1024)
MAX_UPLOAD_SIZE=5242880