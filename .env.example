$envExample = @"
# ========================================
# Webifylab Environment Variables
# Copy this file to .env and fill in values
# ========================================

# Domain
DOMAIN=webifylab.com
WWW_DOMAIN=www.webifylab.com

# VPS
VPS_IP=xxx.xxx.xxx.xxx
VPS_USER=deploy
VPS_SSH_PORT=22

# Golang API (V1.5)
API_PORT=8080
API_HOST=127.0.0.1
API_ENV=development

# Formspree (V1 - fallback)
FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxx

# WhatsApp
WHATSAPP_NUMBER=628xxxxxxxxxx

# Notification (V1.5)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database (V1.5)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=webifylab
DB_PASSWORD=
DB_NAME=webifylab
DB_SSLMODE=disable

# Analytics
PLAUSIBLE_DOMAIN=webifylab.com
"@

Set-Content -Path ".env.example" -Value $envExample -Encoding UTF8
Write-Host "✅ .env.example created" -ForegroundColor Green

# Copy ke .env (untuk local development)
Copy-Item ".env.example" ".env"
Write-Host "✅ .env created (copy dari .env.example)" -ForegroundColor Green